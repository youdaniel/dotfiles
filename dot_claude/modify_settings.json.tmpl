#!/bin/sh
# Merge the shared Claude Code setup into ~/.claude/settings.json: turn on the shared
# plugins and their marketplaces, set shared preferences, and leave every other key
# (autoMode, hooks, model settings, local extra plugins, ...) as it is. Claude Code,
# cswap and herdr all write this file, so chezmoi only owns these keys.
set -e
input=$(cat)
[ -n "$input" ] || input='{}'
printf '%s' "$input" | jq --argjson plugins {{ .claude.plugins | toJson | squote }} '
  # Plugin list: .chezmoidata/claude.yaml
  # clauth was replaced by cswap; drop its plugin and marketplace
  del(.enabledPlugins["clauth@clauth"], .extraKnownMarketplaces.clauth)
  | .enabledPlugins = (.enabledPlugins // {}) + ($plugins | map({(.): true}) | add)
  | .extraKnownMarketplaces = (.extraKnownMarketplaces // {}) + {
    "prismantis": {"source": {"source": "github", "repo": "NahumLitvin/prismantis"}, "autoUpdate": true}
  }
  # prismantis options are shared as a whole set (this Linux machine is the reference)
  # theme follows DMS light/dark via prismantis-theme-sync, so keep the current one
  | (.pluginConfigs["prismantis@prismantis"].options.theme // "catppuccin-mocha") as $theme
  | .pluginConfigs["prismantis@prismantis"].options = {
      "theme": $theme, "tableStyle": "box", "taskStyle": "checks",
      "headingStyle": "banner", "copyButtonStyle": "hover", "promptStyle": "bubble",
      "clock": "12h", "toolStyle": "chat", "toolOutput": "full", "diffStyle": "card",
      "pieStyle": "round", "listMarker": "dots", "replyStyle": "auto"
    }
  | .theme = "auto"
  | .editorMode = "vim"
'
