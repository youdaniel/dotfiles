# Shared via chezmoi on Linux and macOS. Machine-local settings go in ~/.zshrc_local.
[[ -f ~/.zshrc_local ]] && source ~/.zshrc_local

# Hand interactive sessions over to fish (shared via chezmoi). Fish sets up its own
# environment in ~/.config/fish/conf.d, so nothing above this line needs to reach it.
source ~/.config/zsh/fish-handoff.zsh

# ---- Below runs only in plain zsh: NO_FISH=1 zsh, zsh -i -c, zsh started from fish ----

setopt IGNOREEOF

for dir in ~/.local/share/pnpm ~/Library/pnpm; do
  [[ -d $dir ]] && { export PNPM_HOME=$dir; break; }
done

for dir in /opt/android-sdk ~/Library/Android/sdk; do
  [[ -d $dir ]] && { export ANDROID_HOME=$dir; break; }
done

# Highest priority first: ~/.local/bin holds the native claude, which must win over
# older copies in package-manager dirs. Empty PNPM_HOME/ANDROID_HOME entries are skipped.
() {
  local dir; local -a dirs
  for dir in ~/.local/bin ~/.cargo/bin ~/go/bin ~/.bun/bin \
      ${PNPM_HOME:+$PNPM_HOME} ${PNPM_HOME:+$PNPM_HOME/bin} ${ANDROID_HOME:+$ANDROID_HOME/{cmdline-tools/latest/bin,platform-tools,emulator}}; do
    [[ -d $dir ]] && dirs+=($dir)
  done
  path=($dirs $path)
}
typeset -U path

# Plugins via zgenom where it's installed; otherwise just completions
if [[ -f ~/.zgenom/zgenom.zsh ]]; then
  source ~/.zgenom/zgenom.zsh

  zgenom autoupdate

  if ! zgenom saved; then
    echo "Creating a zgenom save"

    zgenom ohmyzsh

    zgenom ohmyzsh plugins/git
    zgenom ohmyzsh plugins/command-not-found
    zgenom ohmyzsh plugins/docker

    zgenom load zsh-users/zsh-autosuggestions
    zgenom load zsh-users/zsh-completions
    zgenom load zdharma-continuum/fast-syntax-highlighting

    zgenom load jeffreytse/zsh-vi-mode

    zgenom save

    zgenom compile "$HOME/.zshrc"
  fi
else
  autoload -Uz compinit && compinit
fi

# NVIM as default editor
if command -v nvim &> /dev/null; then
  export EDITOR=nvim
  export GIT_EDITOR=nvim
  export VISUAL=nvim
fi

if command -v bat &> /dev/null; then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  export MANROFFOPT="-c"
fi

# vim keybindings
bindkey -v

# binding for zsh autosuggestions
bindkey '^ ' autosuggest-accept

# Fast node manager
command -v fnm &> /dev/null && eval "$(fnm env)"

# yazi
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

