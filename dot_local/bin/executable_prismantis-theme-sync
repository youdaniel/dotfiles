#!/bin/sh
# Keep the prismantis theme and the icon theme in step with the desktop light/dark
# mode that DMS sets. DMS dark writes color-scheme 'prefer-dark'; DMS light writes
# 'default'. prismantis reads its theme when it loads, so a switch reaches new
# Claude sessions; the icon theme switch is live.
set -eu
settings="$HOME/.claude/settings.json"
key=org.gnome.desktop.interface

set_prismantis() {
  [ -f "$settings" ] || return 0
  current=$(jq -r '.pluginConfigs["prismantis@prismantis"].options.theme // ""' "$settings")
  [ -n "$current" ] && [ "$current" != "$1" ] || return 0
  tmp=$(mktemp "$settings.XXXXXX")
  jq --arg t "$1" '.pluginConfigs["prismantis@prismantis"].options.theme = $t' "$settings" > "$tmp"
  chmod --reference="$settings" "$tmp"
  mv "$tmp" "$settings"
}

set_icons() {
  [ "$(gsettings get "$key" icon-theme)" = "'$1'" ] || gsettings set "$key" icon-theme "$1"
}

apply() {
  case "$1" in
    *prefer-dark*) set_prismantis catppuccin-mocha; set_icons Papirus-Dark ;;
    *) set_prismantis catppuccin-latte; set_icons Papirus-Light ;;
  esac
}

apply "$(gsettings get "$key" color-scheme)"
gsettings monitor "$key" color-scheme | while read -r _ value; do apply "$value"; done
