#!/bin/sh
# Keep the prismantis theme (and, on Linux, the icon theme) in step with the
# desktop light/dark mode. prismantis reads its theme when it loads, so a switch
# reaches new Claude sessions.
#
# Linux: DMS dark writes color-scheme 'prefer-dark', DMS light writes 'default'.
#   Runs as a systemd user service and follows `gsettings monitor`.
# macOS: AppleInterfaceStyle is "Dark" in dark mode and unset in light mode.
#   A LaunchAgent reruns this whenever the global preferences change.
set -eu
settings="$HOME/.claude/settings.json"
key=org.gnome.desktop.interface

set_prismantis() {
  [ -f "$settings" ] || return 0
  current=$(jq -r '.pluginConfigs["prismantis@prismantis"].options.theme // ""' "$settings")
  [ -n "$current" ] && [ "$current" != "$1" ] || return 0
  tmp=$(mktemp "$settings.XXXXXX")
  jq --arg t "$1" '.pluginConfigs["prismantis@prismantis"].options.theme = $t' "$settings" > "$tmp"
  cat "$tmp" > "$settings"
  rm -f "$tmp"
}

# The DMS bar reads the icon theme only at startup, so restart it after a change.
# The pause lets DMS finish saving the light/dark switch that triggered this.
set_icons() {
  [ "$(gsettings get "$key" icon-theme)" = "'$1'" ] && return 0
  gsettings set "$key" icon-theme "$1"
  sleep 1
  systemctl --user restart dms.service
}

if [ "$(uname)" = Darwin ]; then
  if [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" = Dark ]; then
    set_prismantis catppuccin-mocha
  else
    set_prismantis catppuccin-latte
  fi
  exit 0
fi

apply() {
  case "$1" in
    *prefer-dark*) set_prismantis catppuccin-mocha; set_icons Papirus-Dark ;;
    *) set_prismantis catppuccin-latte; set_icons Papirus-Light ;;
  esac
}

apply "$(gsettings get "$key" color-scheme)"
gsettings monitor "$key" color-scheme | while read -r _ value; do apply "$value"; done
